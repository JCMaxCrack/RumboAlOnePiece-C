[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemies"
3d_physics/layer_4="items"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2
limits/opengl/max_renderable_lights=16
limits/opengl/max_lights_per_object=4
anti_aliasing/quality/screen_space_aa=1
occlusion_culling/use_occlusion_culling=true
mesh_lod/lod_change/threshold_pixels=2.0

[internationalization]

locale/translations=PackedStringArray("res://assets/i18n/translations.en.translation", "res://assets/i18n/translations.es.translation")
locale/fallback="en"
